# Aile Danışmanı - Apache & LiteSpeed Yapılandırması

AddDefaultCharset UTF-8

# Dizin listelemeyi kapat ve içerik anlaşmasını devre dışı bırak
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0a. HTTP -> HTTPS kalıcı yönlendirme (Google tek ve güvenli adres görsün)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1) [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # 0b. www -> www'suz kalıcı yönlendirme (yinelenen içerik oluşmasın)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

    # 0c. Sitemap: /sitemap.xml adresi dinamik sitemap.php dosyasından üretilir
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 1. Klasör değilse sonundaki eğik çizgiyi kaldır (Canonical temiz URL)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/+$
    RewriteRule ^ %1 [R=301,L]

    # 2. Doğrudan index.php çağrıldığında ana sayfaya yönlendir
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[?\s] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # 3. .php uzantılı doğrudan gelen istekleri uzantısız haline 301 kalıcı yönlendir
    # POST istekleri, admin, api ve install.php hariç tutulur
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([a-zA-Z0-9_-]+)\.php[?\s] [NC]
    RewriteCond %{REQUEST_URI} !^/admin/ [NC]
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/install\.php [NC]
    RewriteCond %{REQUEST_URI} !^/sitemap\.php [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 4. Blog ve Eğitim Detayları için temiz URL yönlendirmeleri
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-detay.php?slug=$1 [L,QSA]
    RewriteRule ^egitim/([a-zA-Z0-9_-]+)/?$ egitim-detay.php?slug=$1 [L,QSA]

    # 5. Uzantısız gelen istek için aynı isimde .php dosyası varsa içeriden çalıştır
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# Güvenlik: SQLite ve SQL dosyalarına doğrudan erişimi engelle
<FilesMatch "\.(sqlite|sqlite-journal|sql|log|md|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# PHP Önbellek & Sıkıştırma (Gzip)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Tarayıcı önbelleği (sayfa hızı Google sıralamasını etkiler)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Özel 404 sayfası
ErrorDocument 404 /404.php
